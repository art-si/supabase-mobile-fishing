{
  "name": "supabase-mobile-fishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "brand:generate": "tsx scripts/generate-brand.mjs",
    "prepare:core": "mobile-pro prepare",
    "dev:h5": "mobile-pro uni -p h5 --host 0.0.0.0 --port 5178",
    "preview:h5": "mobile-pro vite preview --host 0.0.0.0 --port 5178 --strictPort --outDir dist/build/h5",
    "preview:docs": "node scripts/preview-docs.mjs",
    "dev:mp-weixin": "mobile-pro uni -p mp-weixin",
    "build:h5": "mobile-pro uni build -p h5",
    "build:docs": "node scripts/build-docs.mjs",
    "build:mp-weixin": "mobile-pro uni build -p mp-weixin && node scripts/check-miniapp-package.mjs",
    "typecheck": "mobile-pro typecheck --noEmit --pretty false",
    "test": "mobile-pro prepare && tsx --test tests/*.test.ts",
    "test:account": "node scripts/test-login.mjs --profile=active && node scripts/test-account-security.mjs",
    "test:publishing": "node scripts/test-publishing-build.mjs",
    "test:db": "node tests/database.mjs && node tests/media-cleanup.mjs",
    "test:h5": "node scripts/smoke-h5.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:h5:unconfigured": "node scripts/test-unconfigured.mjs",
    "test:map": "node scripts/test-map.mjs",
    "test:moderation": "node scripts/test-moderation.mjs",
    "test:session": "node scripts/test-session.mjs",
    "test:author": "node scripts/test-author.mjs",
    "test:water-report": "node scripts/test-water-report.mjs",
    "test:water-report-ui": "node scripts/test-water-report-ui.mjs",
    "test:visual": "node scripts/smoke-h5.mjs --visual-audit-only",
    "test:remote": "pwsh -NoProfile -File tests/remote-readonly.ps1",
    "check:miniapp": "node scripts/check-miniapp-package.mjs",
    "check:miniapp:wxml": "node scripts/check-miniapp-wxml.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "format": "prettier --write --no-error-on-unmatched-pattern src scripts tests *.json *.ts *.mjs *.html *.yaml",
    "check": "pnpm typecheck && pnpm test && pnpm test:db",
    "native:add": "mobile-pro cap add",
    "native:sync": "pnpm build:h5 && mobile-pro cap sync",
    "android:open": "mobile-pro cap open android",
    "ios:open": "mobile-pro cap open ios",
    "release:check": "node scripts/release-check.mjs",
    "release:weixin": "node scripts/release-miniapp.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/camera": "8.2.6",
    "@mapbox/point-geometry": "1.1.0",
    "@mapbox/vector-tile": "3.0.0",
    "@supabase/phoenix": "0.4.5",
    "@supabase/realtime-js": "2.118.0",
    "core-js": "3.51.0",
    "libheif-js": "1.23.5",
    "mediabunny": "1.66.2",
    "pbf": "5.2.0",
    "supabase-mobile-pro": "https://gitee.com/art-si/supabase-mobile-pro/repository/archive/4d09f98a0b77734e64960a1638a32b3b9dd35f2a.tar.gz"
  },
  "devDependencies": {
    "@capacitor/ios": "8.6.2",
    "@electric-sql/pglite": "0.3.14",
    "@vant/area-data": "2.2.0",
    "polygon-clipping": "0.15.7",
    "prettier": "3.6.2",
    "tsx": "4.20.6"
  }
}
