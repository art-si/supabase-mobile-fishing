{
  "name": "supabase-mobile-fishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "brand:generate": "tsx scripts/generate-brand.mjs",
    "prepare:core": "node scripts/mobile-pro.mjs",
    "dev:h5": "uni -p h5 --host 0.0.0.0 --port 5178",
    "dev:demo": "uni -p h5 --mode demo --host 0.0.0.0 --port 5178",
    "preview:h5": "vite preview --host 0.0.0.0 --port 5178 --strictPort --outDir dist/build/h5",
    "preview:demo": "vite preview --host 0.0.0.0 --port 5178 --strictPort --outDir dist/demo/h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:demo": "uni build -p h5 --mode demo --outDir dist/demo/h5",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/check-miniapp-package.mjs",
    "build:mp-demo": "uni build -p mp-weixin --mode demo --outDir dist/demo/mp-weixin",
    "typecheck": "node scripts/mobile-pro.mjs && vue-tsc --noEmit --pretty false",
    "test": "tsx --test tests/*.test.ts",
    "test:account": "node scripts/test-login.mjs --profile=active && node scripts/test-account-security.mjs",
    "test:publishing": "node scripts/test-publishing-build.mjs",
    "test:db": "node tests/database.mjs && node tests/media-cleanup.mjs",
    "test:h5": "node scripts/smoke-h5.mjs",
    "test:h5:unconfigured": "node scripts/test-unconfigured.mjs",
    "test:map": "node scripts/test-map.mjs",
    "test:moderation": "node scripts/test-moderation.mjs",
    "test:session": "node scripts/test-session.mjs",
    "test:author": "node scripts/test-author.mjs",
    "test:water-report": "node scripts/test-water-report.mjs",
    "test:water-report-ui": "node scripts/test-water-report-ui.mjs",
    "test:visual": "node scripts/smoke-h5.mjs --visual-audit",
    "test:remote": "pwsh -NoProfile -File tests/remote-readonly.ps1",
    "check:miniapp": "node scripts/check-miniapp-package.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "format": "prettier --write --no-error-on-unmatched-pattern src scripts tests *.json *.ts *.mjs *.html *.yaml",
    "check": "pnpm typecheck && pnpm test && pnpm test:db",
    "native:add": "cap add",
    "native:sync": "pnpm build:h5 && cap sync",
    "native:sync:demo": "pnpm build:demo && node scripts/native-demo.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/synapse": "1.0.4",
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-cloud": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-console": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-i18n": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-push": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-shared": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-stat": "3.0.0-alpha-1000920260626810",
    "@supabase/phoenix": "0.4.5",
    "@supabase/realtime-js": "2.118.0",
    "@wot-ui/ui": "2.3.2",
    "core-js": "3.51.0",
    "libheif-js": "1.23.5",
    "mediabunny": "1.66.2",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-demi": "0.14.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-1000920260626810",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260626810",
    "@electric-sql/pglite": "0.3.14",
    "@vant/area-data": "2.2.0",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/tsconfig": "0.9.1",
    "playwright": "1.63.0",
    "polygon-clipping": "0.15.7",
    "prettier": "3.6.2",
    "sass": "1.101.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vue-tsc": "3.3.5"
  }
}
