# Copy to .env.local. Never put service_role, database password or SMS secrets here.
# GitHub Pages uses .env.pages / .env.pages.local; see .env.pages.example.
VITE_DATA_MODE=live
VITE_SUPABASE_URL=https://jupuypvmgjpnpntfetqv.supabase.co
VITE_SUPABASE_KEY=
# Public browser key; security code belongs in your server-side _AMapService proxy.
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=/_AMapService
# Public HTTPS data directory holding the shoreline manifest and versioned tiles.
VITE_WATER_INDEX_BASE_URL=
# Local Vite dev/preview proxy only; this non-VITE variable is never bundled.
# node scripts/reuse-amap.mjs imports it from the owner's adjacent Pro checkout.
AMAP_SECURITY_JS_CODE=
# Mini Program uses the authenticated amap Edge Function, not web-view.
# AMAP_WEB_SERVICE_KEY belongs in Supabase Function Secrets only, never VITE_*.
# Enable only in an approved test/release environment with SMS provider and privacy policy.
VITE_PHONE_AUTH_ENABLED=false
# Only enable after the identity-to-Supabase-session bridge is deployed and verified.
# WeChat getPhoneNumber is hard-disabled for the confirmed personal account.
VITE_OPERATOR_PHONE_ENABLED=false
# Optional CAPTCHA supplied to Supabase Auth, never a secret.
VITE_AUTH_CAPTCHA_ENABLED=false
