# Public defaults for GitHub Pages builds. Keys stay in ignored local files.
VITE_DATA_MODE=live
VITE_SUPABASE_URL=https://jupuypvmgjpnpntfetqv.supabase.co
# GitHub Pages has no /_AMapService reverse proxy. Set an absolute HTTPS proxy
# in .env.pages.local; do not inherit the development proxy from .env.local.
VITE_AMAP_SERVICE_HOST=
