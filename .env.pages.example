# Copy to .env.pages.local and fill public values, or set only the overrides
# you need when .env.local already contains the public keys.
VITE_SUPABASE_URL=https://jupuypvmgjpnpntfetqv.supabase.co
VITE_SUPABASE_KEY=
VITE_AMAP_KEY=
# Required for the interactive map. Pages itself cannot serve this endpoint.
# Example shape: https://your-map-proxy.example/_AMapService
VITE_AMAP_SERVICE_HOST=
# Empty uses the shoreline data shipped under docs/static/web/water-index/.
VITE_WATER_INDEX_BASE_URL=
# Enable only after the corresponding real service has been verified.
VITE_PHONE_AUTH_ENABLED=false
VITE_OPERATOR_PHONE_ENABLED=false
VITE_AUTH_CAPTCHA_ENABLED=false
# Never add server credentials, AMAP_SECURITY_JS_CODE or AMAP_WEB_SERVICE_KEY here.
# The amap-js Edge Function must allow the exact origin https://art-si.github.io.
